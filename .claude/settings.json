{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mem >/dev/null 2>&1 && mem hook compact || true",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v mem >/dev/null 2>&1 && mem hook prompt || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
